+@pytest.mark.asyncio
+@pytest.mark.fake_live
+async def test_documented_terminal_scenario_reconciles_closing_loss_unmodified(tmp_path):
+    import passivbot_rust as pbr
+
+    if getattr(pbr, "__is_stub__", False):
+        pytest.skip("requires real passivbot_rust extension")
+    user = f"fake_terminal_reconciled_{tmp_path.name}"
+    _cleanup_fake_user_state(user)
+    try:
+        args = argparse.Namespace(
+            config=str(REPO_ROOT / "configs" / "fake_live_hsl_btc.hjson"),
+            scenario=str(REPO_ROOT / "scenarios" / "fake_live" / "hsl_long_terminal_no_restart.hjson"),
+            user=user,
+            max_steps=None,
+            output_dir=str(tmp_path),
+            log_level=1,
+            snapshot_each_step=True,
+        )
+        assert await _async_main(args) == 0
+        run_dir = next(path for path in tmp_path.iterdir() if (path / "run_metadata.json").exists())
+        artifacts = _load_run_artifacts(run_dir)
+        assert artifacts["run_metadata"]["assertions_enforced"] is True
+        stop = artifacts["hsl_trace"]["long"]["last_stop_event"]
+        assert stop["realized_pnl_total"] == pytest.approx(-100.0)
+        assert stop["drawdown_raw"] == pytest.approx(1.0)
+        assert stop["no_restart_latched"] is True
+        assert artifacts["fake_exchange_state"]["open_orders"] == []
+        assert artifacts["positions"] == []
+    finally:
+        _cleanup_fake_user_state(user)
+
+
